meta {
  name: Recomendaciones IA
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/ai/recommendations
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "userId": 1,
    "restrictions": ["VEGETARIANO"],
    "preferences": ["económico", "saludable"],
    "maxRecommendations": 3
  }
}