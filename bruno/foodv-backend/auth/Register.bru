meta {
  name: Register
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "nombres": "Xavier",
    "apellidos": "David",
    "email": "xavier@foodv.com",
    "password": "TestPass123",
    "telefono": "999999999",
    "role": "ESTUDIANTE",
    "preferences": ["pollo", "arroz", "menú ejecutivo"],
    "restrictions": [],
    "budgetRange": "MEDIO",
    "cuisineTypes": ["criolla", "china"]
  }
}

script:after-response {
  if (res.status === 201) {
    bru.setEnvVar("userId", res.body.id);
  }
}
